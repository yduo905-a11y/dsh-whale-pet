<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MascotRoot" Width="200" Height="210">
  <Canvas.Resources>
    <LinearGradientBrush x:Key="HairFront" StartPoint="0,0" EndPoint="0.35,1">
      <GradientStop Color="#B6F0FF" Offset="0"/>
      <GradientStop Color="#63CDF7" Offset="0.5"/>
      <GradientStop Color="#2B96DC" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HairBack" StartPoint="0,0" EndPoint="0.4,1">
      <GradientStop Color="#8CE0FF" Offset="0"/>
      <GradientStop Color="#3AA3E3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Skin" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFEF6EE" Offset="0"/>
      <GradientStop Color="#FFF7E4D6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DressFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFFF" Offset="0"/>
      <GradientStop Color="#DCEEFB" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IrisFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#0B4A8F" Offset="0"/>
      <GradientStop Color="#2E9FE0" Offset="0.55"/>
      <GradientStop Color="#9CE6FF" Offset="1"/>
    </LinearGradientBrush>
  </Canvas.Resources>

  <!-- 鲸尾发饰（背景） -->
  <Path x:Name="TailClip" Fill="#5AC8F7" Stroke="#2E9BDE" StrokeThickness="1.5"
        Data="M 168,120 C 178,106 192,102 199,104 C 191,113 191,126 198,133 C 186,136 174,131 168,120 Z"/>

  <!-- 后发 -->
  <Path x:Name="HairBack" Fill="{StaticResource HairBack}"
        Data="M 26,120 C 18,60 52,18 100,18 C 148,18 182,60 174,120 C 172,150 160,178 146,190 C 138,197 128,192 130,180 L 136,120 L 64,120 L 70,180 C 72,192 62,197 54,190 C 40,178 28,150 26,120 Z"/>
  <Path x:Name="TailL" Fill="{StaticResource HairBack}" Stroke="#2E9BDE" StrokeThickness="1"
        Data="M 34,110 C 20,146 22,186 40,194 C 54,200 62,186 58,164 L 48,110 Z"/>
  <Path x:Name="TailR" Fill="{StaticResource HairBack}" Stroke="#2E9BDE" StrokeThickness="1"
        Data="M 166,110 C 180,146 178,186 160,194 C 146,200 138,186 142,164 L 152,110 Z"/>

  <!-- 耳朵 -->
  <Ellipse Canvas.Left="32" Canvas.Top="84" Width="22" Height="28" Fill="{StaticResource Skin}"/>
  <Ellipse Canvas.Left="146" Canvas.Top="84" Width="22" Height="28" Fill="{StaticResource Skin}"/>

  <!-- 脖子 -->
  <Rectangle Canvas.Left="92" Canvas.Top="136" Width="16" Height="18" RadiusX="6" RadiusY="6" Fill="{StaticResource Skin}"/>

  <!-- 手臂 -->
  <Ellipse Canvas.Left="50" Canvas.Top="156" Width="24" Height="34" Fill="{StaticResource Skin}">
    <Ellipse.RenderTransform><RotateTransform Angle="-14" CenterX="12" CenterY="6"/></Ellipse.RenderTransform>
  </Ellipse>
  <Ellipse Canvas.Left="126" Canvas.Top="156" Width="24" Height="34" Fill="{StaticResource Skin}">
    <Ellipse.RenderTransform><RotateTransform Angle="14" CenterX="12" CenterY="6"/></Ellipse.RenderTransform>
  </Ellipse>

  <!-- 女仆裙 -->
  <Path x:Name="Dress" Fill="{StaticResource DressFill}" Stroke="#BFE3F7" StrokeThickness="1.2"
        Data="M 76,148 L 124,148 C 136,166 143,194 139,206 L 61,206 C 57,194 64,166 76,148 Z"/>
  <Path Fill="#63CDF7" Opacity="0.75"
        Data="M 76,148 L 124,148 C 127,153 129,158 131,164 L 69,164 C 71,158 73,153 76,148 Z"/>
  <Ellipse Canvas.Left="46" Canvas.Top="196" Width="26" Height="15" Fill="#FFFFFF" Stroke="#BFE3F7" StrokeThickness="1"/>
  <Ellipse Canvas.Left="128" Canvas.Top="196" Width="26" Height="15" Fill="#FFFFFF" Stroke="#BFE3F7" StrokeThickness="1"/>
  <Ellipse Canvas.Left="95" Canvas.Top="146" Width="10" Height="10" Fill="#2FA8E0"/>
  <Path Fill="#34B3E8" Data="M 96,150 L 84,143 L 84,159 Z"/>
  <Path Fill="#34B3E8" Data="M 104,150 L 116,143 L 116,159 Z"/>

  <!-- 头 -->
  <Ellipse x:Name="Head" Canvas.Left="38" Canvas.Top="36" Width="124" Height="112"
           Fill="{StaticResource Skin}" Stroke="#F0D6C4" StrokeThickness="0.8"/>

  <!-- 腮红 -->
  <Ellipse Canvas.Left="48" Canvas.Top="120" Width="26" Height="13" Fill="#FF9BB0" Opacity="0.45"/>
  <Ellipse Canvas.Left="126" Canvas.Top="120" Width="26" Height="13" Fill="#FF9BB0" Opacity="0.45"/>

  <!-- 眼睛整组（眨眼靠整组 ScaleY） -->
  <Canvas x:Name="Eyes" Width="200" Height="210" RenderTransformOrigin="0.5,0.5">
    <Canvas.RenderTransform>
      <ScaleTransform x:Name="EyesScale" ScaleX="1" ScaleY="1"/>
    </Canvas.RenderTransform>

    <!-- 眼白 -->
    <Ellipse Canvas.Left="63" Canvas.Top="88" Width="30" Height="34" Fill="#FFFFFF" Opacity="0.96"/>
    <Ellipse Canvas.Left="107" Canvas.Top="88" Width="30" Height="34" Fill="#FFFFFF" Opacity="0.96"/>

    <!-- 虹膜 -->
    <Ellipse Canvas.Left="67" Canvas.Top="92" Width="23" Height="29" Fill="{StaticResource IrisFill}"/>
    <Ellipse Canvas.Left="111" Canvas.Top="92" Width="23" Height="29" Fill="{StaticResource IrisFill}"/>

    <!-- 瞳孔 -->
    <Ellipse Canvas.Left="74" Canvas.Top="99" Width="10" Height="16" Fill="#072C5C"/>
    <Ellipse Canvas.Left="118" Canvas.Top="99" Width="10" Height="16" Fill="#072C5C"/>

    <!-- 高光 -->
    <Ellipse Canvas.Left="69" Canvas.Top="93" Width="9" Height="8" Fill="#FFFFFF"/>
    <Ellipse Canvas.Left="113" Canvas.Top="93" Width="9" Height="8" Fill="#FFFFFF"/>
    <Ellipse Canvas.Left="80" Canvas.Top="110" Width="6" Height="5" Fill="#FFFFFF" Opacity="0.85"/>
    <Ellipse Canvas.Left="124" Canvas.Top="110" Width="6" Height="5" Fill="#FFFFFF" Opacity="0.85"/>

    <!-- 半眯眼眼皮（画在最上层，制造"无语"表情） -->
    <Ellipse Canvas.Left="62" Canvas.Top="86" Width="32" Height="15" Fill="{StaticResource Skin}"/>
    <Ellipse Canvas.Left="106" Canvas.Top="86" Width="32" Height="15" Fill="{StaticResource Skin}"/>
    <Path Stroke="#2B6FA8" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
          Data="M 62,97 C 70,90 88,90 95,98"/>
    <Path Stroke="#2B6FA8" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
          Data="M 106,98 C 113,90 131,90 138,97"/>
  </Canvas>

  <!-- 嘴（ω 型） -->
  <Path Stroke="#C4645F" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
        Data="M 94,132 Q 97,139 100,132 Q 103,139 106,132"/>

  <!-- 前发（刘海） -->
  <Path x:Name="Bangs" Fill="{StaticResource HairFront}"
        Data="M 40,94 C 40,52 66,28 100,28 C 134,28 160,52 160,94 L 150,80 L 141,96 L 130,76 L 119,94 L 110,72 L 100,90 L 90,72 L 79,94 L 68,76 L 57,96 L 48,80 Z"/>
  <Path x:Name="SideLockL" Fill="{StaticResource HairFront}"
        Data="M 40,88 C 30,112 30,142 40,160 C 48,169 58,160 57,146 C 54,124 50,104 48,88 Z"/>
  <Path x:Name="SideLockR" Fill="{StaticResource HairFront}"
        Data="M 160,88 C 170,112 170,142 160,160 C 152,169 142,160 143,146 C 146,124 150,104 152,88 Z"/>

  <!-- 女仆头饰 -->
  <Ellipse Canvas.Left="46" Canvas.Top="46" Width="26" Height="26" Fill="#FFFFFF" Stroke="#CFEBFB" StrokeThickness="1"/>
  <Ellipse Canvas.Left="67" Canvas.Top="38" Width="28" Height="28" Fill="#FFFFFF" Stroke="#CFEBFB" StrokeThickness="1"/>
  <Ellipse Canvas.Left="90" Canvas.Top="34" Width="30" Height="30" Fill="#FFFFFF" Stroke="#CFEBFB" StrokeThickness="1"/>
  <Ellipse Canvas.Left="114" Canvas.Top="38" Width="28" Height="28" Fill="#FFFFFF" Stroke="#CFEBFB" StrokeThickness="1"/>
  <Ellipse Canvas.Left="136" Canvas.Top="46" Width="26" Height="26" Fill="#FFFFFF" Stroke="#CFEBFB" StrokeThickness="1"/>
  <Path x:Name="Ribbon" Fill="#2FA8E0" Stroke="#1E88C7" StrokeThickness="1"
        Data="M 152,58 L 166,44 L 169,62 Z M 152,58 L 138,44 L 135,62 Z"/>
  <Ellipse Canvas.Left="146" Canvas.Top="53" Width="13" Height="13" Fill="#1E88C7"/>

  <!-- 呆毛 -->
  <Path x:Name="Ahoge" Stroke="#6FD3FF" StrokeThickness="5.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
        Data="M 100,31 C 94,16 104,8 114,5">
    <Path.RenderTransform><RotateTransform x:Name="AhogeRotate" Angle="0" CenterX="100" CenterY="31"/></Path.RenderTransform>
  </Path>

  <!-- 汗滴（低余额时出现） -->
  <Path x:Name="Sweat" Opacity="0" Fill="#A8E4FF" Stroke="#6FC9F0" StrokeThickness="1"
        Data="M 162,60 C 172,72 175,80 168,85 C 160,90 152,83 154,73 Z"/>
</Canvas>
